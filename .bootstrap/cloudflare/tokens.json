[
  {
    "token": "Preview",
    "secret": "CLOUDFLARE_PREVIEW_TOKEN",
    "env": null,
    "workers": ["preview"],
    "permissions": ["Individual Workers Editor", "Account Settings Read", "D1 Write"]
  },
  {
    "token": "Deploy",
    "secret": "CLOUDFLARE_DEPLOY_TOKEN",
    "env": ["production"],
    "workers": ["production", "beta"],
    "zone": true,
    "permissions": ["Individual Workers Editor", "Account Settings Read", "Workers Routes Write", "D1 Write", "Workers Scripts Read"]
  },
  {
    "token": "Infra plan",
    "secret": "CLOUDFLARE_INFRA_PLAN_TOKEN",
    "env": null,
    "zone": true,
    "permissions": [
      "D1 Read",
      "Notifications Read",
      "DNS Read",
      "Zone Settings Read",
      "Zone WAF Read",
      "Cache Settings Read",
      "Transform Rules Read",
      "Dynamic URL Redirects Read",
      "Bot Management Read"
    ]
  },
  {
    "token": "Infra apply",
    "secret": "CLOUDFLARE_INFRA_APPLY_TOKEN",
    "env": ["infra"],
    "zone": true,
    "permissions": [
      "D1 Write",
      "Notifications Write",
      "DNS Write",
      "Zone Settings Write",
      "Zone WAF Write",
      "Cache Settings Write",
      "Transform Rules Write",
      "Dynamic URL Redirects Write",
      "Bot Management Write"
    ]
  }
]
