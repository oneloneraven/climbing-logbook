<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad&render=explicit" async defer></script>

<h1>Tell us what you think</h1>

<p class="text-muted mb-4">Like something? Wish something worked differently? We'd love to hear it.</p>

<form id="feedback-form" novalidate>
  <label class="block text-sm text-muted mb-1" for="feedback-message">What do you think? <span class="text-accent-ink" aria-hidden="true">*</span></label>
  <textarea
    class="text-input w-full mb-1 min-h-[8rem]"
    id="feedback-message" name="message" required></textarea>
  <div class="text-xs text-muted text-right mb-4" id="feedback-message-count"></div>

  <label class="block text-sm text-muted mb-1" for="feedback-email">Your email <span class="text-muted">(we can't guarantee a response but we might reach out if needed)</span></label>
  <input
    class="text-input w-full mb-4"
    type="email" id="feedback-email" name="contactEmail" autocomplete="email">

  <label class="block text-sm text-muted mb-1" for="feedback-section">Which part of the app? <span class="text-muted">(optional)</span></label>
  <select class="text-input w-full mb-4" id="feedback-section" name="section">
    <option value="">Not sure / other</option>
    <option value="logbook">Logbook</option>
    <option value="map">Map</option>
    <option value="performance">Performance Insights</option>
    <option value="account">My Account</option>
    <option value="import_export">Import &amp; export</option>
    <option value="help">Help pages</option>
  </select>

  <fieldset class="min-w-0 border-0 p-0 mb-4" aria-describedby="feedback-quote-hint">
    <legend class="block text-sm text-muted mb-1">Can we quote you? <span class="text-muted">(optional)</span></legend>
    <div class="text-sm text-muted mb-2" id="feedback-quote-hint">We might share what you said on the site or our socials. We never show your email address.</div>
    <label class="flex items-start gap-2 text-sm mb-2 cursor-pointer" for="feedback-quote-consent">
      <input class="mt-0.5 size-4 shrink-0 accent-accent-strong" type="checkbox" id="feedback-quote-consent" name="quoteConsent" value="true">
      <span>Yes, you can quote what I said</span>
    </label>
    <div class="flex flex-col gap-2 mb-3">
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <input class="size-4 shrink-0 accent-accent-strong" type="radio" name="credit" value="anonymous" checked>
        <span>Don't show my name</span>
      </label>
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <input class="size-4 shrink-0 accent-accent-strong" type="radio" name="credit" value="initials">
        <span>Show my initials</span>
      </label>
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <input class="size-4 shrink-0 accent-accent-strong" type="radio" name="credit" value="name">
        <span>Show my name</span>
      </label>
    </div>
    <label class="block text-sm text-muted mb-1" for="feedback-name">Your name <span class="text-muted">(optional)</span></label>
    <input class="text-input w-full" type="text" id="feedback-name" name="contactName" maxlength="100" autocomplete="name">
  </fieldset>

  {# A honeypot: people never see or reach it, so anything in it came from a bot. #}
  <div class="sr-only" aria-hidden="true">
    <label for="feedback-hpx">Leave this empty</label>
    <input id="feedback-hpx" name="hpx" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div id="turnstile-widget" class="mb-4"></div>

  <p class="mb-4 error-message" id="feedback-error" role="alert" aria-live="assertive" tabindex="-1" hidden></p>


  <button type="submit" class="btn btn-primary px-8 disabled:opacity-[.45] disabled:cursor-not-allowed" id="feedback-submit-btn">Send feedback</button>
</form>

<div class="bg-surface border border-border rounded-app p-6 text-center" id="feedback-success" hidden>
  <h2 class="font-display text-2xl mb-2 tracking-wide">Thanks</h2>
  <p class="haiku">We appreciate<br>you taking the time to share<br>your thoughts and feedback</p>
</div>
